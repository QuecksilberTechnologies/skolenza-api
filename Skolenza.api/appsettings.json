{
  "PortalDomainVerification": {
    "DnsOverHttpsEndpoint": "https://cloudflare-dns.com/dns-query"
  },
  "Billing": {
    "PaymentRetryCount": 3,
    "GracePeriodDays": 1,
    "WebhookProcessingRetryCount": 5,
    "ReconciliationLookbackDays": 7,
    "PaymentTimeoutMinutes": 30
  },
  "BulkImport": {
    "WorkerEnabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "BatchTimeoutSeconds": 60
  },
  "ConnectionStrings": {

    "DefaultConnection": ""
 
    

  },
  "AWSUploads": {
    "Region": "ap-south-1",
    "BucketName": "Skolenzadoc",
    "BasePath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
 
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "DeviceGateway": {
    "PublicBaseUrl": "https://skolenza-api.onrender.com"
  },
  "StaffMemberMonitoringStorage": {
    "Provider": "FileSystem",
    "RootPath": "App_Data/staff-member-monitoring",
    "MaximumUploadBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/webp" ]
  },
  "DeviceMqtt": {
    "Mqtt": {
      "Enabled": false,
      "Host": "",
      "Port": 1883,
      "ClientId": "skolenza-device-gateway-mqtt",
      "TopicSuffix": ""
    },
    "Mqtts": {
      "Enabled": false,
      "Host": "",
      "Port": 8883,
      "ClientId": "skolenza-device-gateway-mqtts",
      "TopicSuffix": ""
    }
  },
  //"FileSettings": {
  //  "BaseUrl": "http://localhost:5170/",
  //  "RootFolder": "wwwroot/uploads/",
  //  "InstitutionFolder": "institutions",
  //  "DefaultFolder": "defaults",
  //  "DefaultImage": "defaults/default.png"
  //},
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Verbose", // Verbose logging level set
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "JWTSettings": {
    "Secret": "YourVerySecureRandomlyGeneratedKeyHere",
    "Issuer": "skolenzaApp",
    "Audience": "skolenzaUsers",
    "TokenLifetime": "00:30:00" // Token lifetime, yahan 30 minutes hai
  },
  "AllowedHosts": "*"
}
